{
  "name": "supercell-mcp",
  "version": "1.1.0",
  "type": "module",
  "description": "MCP server for the Clash of Clans, Clash Royale and Brawl Stars APIs",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/tools.test.js",
    "lint": "eslint .",
    "surface": "mcp-surface node src/index.js --snapshot mcp-surface.json --fail-on warn",
    "surface:update": "mcp-surface node src/index.js --snapshot mcp-surface.json --update-snapshot"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "clash-of-clans",
    "clash-royale",
    "brawl-stars",
    "supercell"
  ],
  "license": "MIT",
  "author": "Brett Adams",
  "bin": {
    "supercell-mcp": "src/index.js"
  },
  "files": [
    "src",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brettadams0/supercell-mcp.git"
  },
  "homepage": "https://github.com/brettadams0/supercell-mcp#readme",
  "bugs": {
    "url": "https://github.com/brettadams0/supercell-mcp/issues"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "mcp-surface": "^0.3.0"
  }
}
